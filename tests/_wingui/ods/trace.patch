diff --git a/zz_odstrace.go b/zz_odstrace.go
new file mode 100644
index 0000000..164fe31
--- /dev/null
+++ b/zz_odstrace.go
@@ -0,0 +1,13 @@
+//go:build windows
+
+package walk
+
+// ODSTrace receives the WM_DRAWITEM state and the chosen background of owner
+// drawn ListBox items. Test hook for tests/_wingui/ods, never commit it.
+var ODSTrace func(format string, args ...any)
+
+func odsTrace(format string, args ...any) {
+	if ODSTrace != nil {
+		ODSTrace(format, args...)
+	}
+}
