@@ -0,0 +1,13 @@
+//go:build windows
+
+package walk
+
+// HDNTrace receives the header notifications of a TableView and its
+// updateLVSizes calls. Test hook for tests/_wingui/hdn, never commit it.
+var HDNTrace func(format string, args ...any)
+
+// TableViewHandles returns the list view and header windows of tv. Test hook
+// for tests/_wingui/hdn, never commit it.
+func TableViewHandles(tv *TableView) (frozenLV, normalLV, frozenHdr, normalHdr uintptr) {
+	return uintptr(tv.hwndFrozenLV), uintptr(tv.hwndNormalLV), uintptr(tv.hwndFrozenHdr), uintptr(tv.hwndNormalHdr)
+}
